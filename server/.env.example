# Скопируйте файл в .env и укажите свои значения
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_agency
# Секрет для подписи сессионных токенов (обязательно смените!)
JWT_SECRET=change-me-to-a-long-random-string
# true – если сайт работает по HTTPS
COOKIE_SECURE=false
# Администратор по умолчанию (создаётся командой npm run seed)
ADMIN_EMAIL=admin@travel.local
ADMIN_PASSWORD=Admin123!
